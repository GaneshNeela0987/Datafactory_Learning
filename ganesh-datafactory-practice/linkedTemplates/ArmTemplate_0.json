		{
			"name": "[concat(parameters('factoryName'), '/PL_DummyJSON_Products_Ingest')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Extracts Products from DummyJSON via offset/limit pagination, lands raw JSON in ADLS Gen2, reads each page directly from REST to flatten products into SQL staging, merges into curated, updates watermark, logs failures.",
				"activities": [
					{
						"name": "Lookup_GetWatermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.00:05:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": {
									"value": "SELECT WatermarkValue FROM dbo.ETL_Watermark WHERE SourceSystem = '@{pipeline().parameters.SourceSystem}' AND EntityName = '@{pipeline().parameters.EntityName}'",
									"type": "Expression"
								},
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_Watermark",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "SetVar_Skip",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Lookup_GetWatermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {

							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "MERGE dbo.Products_Curated AS tgt\nUSING dbo.stg_Products AS src\nON tgt.Id = src.Id\nWHEN MATCHED THEN\n    UPDATE SET\n        tgt.Title = src.Title,\n        tgt.Description = src.Description,\n        tgt.Category = src.Category,\n        tgt.Price = src.Price,\n        tgt.DiscountPercentage = src.DiscountPercentage,\n        tgt.Rating = src.Rating,\n        tgt.Stock = src.Stock,\n        tgt.Brand = src.Brand,\n        tgt.Sku = src.Sku,\n        tgt.Weight = src.Weight,\n        tgt.DimensionWidth = src.DimensionWidth,\n        tgt.DimensionHeight = src.DimensionHeight,\n        tgt.DimensionDepth = src.DimensionDepth,\n        tgt.WarrantyInformation = src.WarrantyInformation,\n        tgt.ShippingInformation = src.ShippingInformation,\n        tgt.AvailabilityStatus = src.AvailabilityStatus,\n        tgt.ReturnPolicy = src.ReturnPolicy,\n        tgt.MinimumOrderQuantity = src.MinimumOrderQuantity,\n        tgt.Barcode = src.Barcode,\n        tgt.QrCode = src.QrCode,\n        tgt.CreatedAt = src.CreatedAt,\n        tgt.UpdatedAt = src.UpdatedAt,\n        tgt.Thumbnail = src.Thumbnail,\n        tgt.LastModifiedDate = SYSUTCDATETIME()\nWHEN NOT MATCHED BY TARGET THEN\n    INSERT (\n        Id, Title, Description, Category, Price, DiscountPercentage, Rating,\n        Stock, Brand, Sku, Weight, DimensionWidth, DimensionHeight, DimensionDepth,\n        WarrantyInformation, ShippingInformation, AvailabilityStatus, ReturnPolicy,\n        MinimumOrderQuantity, Barcode, QrCode, CreatedAt, UpdatedAt, Thumbnail,\n        LastModifiedDate\n    )\n    VALUES (\n        src.Id, src.Title, src.Description, src.Category, src.Price, src.DiscountPercentage, src.Rating,\n        src.Stock, src.Brand, src.Sku, src.Weight, src.DimensionWidth, src.DimensionHeight, src.DimensionDepth,\n        src.WarrantyInformation, src.ShippingInformation, src.AvailabilityStatus, src.ReturnPolicy,\n        src.MinimumOrderQuantity, src.Barcode, src.QrCode, src.CreatedAt, src.UpdatedAt, src.Thumbnail,\n        SYSUTCDATETIME()\n    );",
										"type": "Expression"
									}
								}
							]
						}
					},
